    public static void playRound(Scanner input, String prompts, String answers) {
        int score = 0;
        int totalQuestions = 0;

        // Keep slicing off one prompt and one answer at a time until none are left
        while (prompts.indexOf("|") != -1) {
            totalQuestions++;

            // Unit 2: Using indexOf() and substring() to extract the next prompt & answer
            int promptCut = prompts.indexOf("|");
            String currentPrompt = prompts.substring(0, promptCut);
            prompts = prompts.substring(promptCut + 1);

            int answerCut = answers.indexOf("|");
            String currentAnswer = answers.substring(0, answerCut);
            answers = answers.substring(answerCut + 1);

            System.out.println("\nQuestion " + totalQuestions + ": " + currentPrompt);
            boolean guessedRight = false;
            int tries = 0;

            // Give the player up to 3 tries per question
            while (tries < 3 && !guessedRight) {
                System.out.print("Your guess (or type 'hint' / 'quit'): ");
                String guess = input.nextLine().trim();

                if (guess.equalsIgnoreCase("quit")) {
                    System.out.println("\nEnding round early...");
                    System.out.println("Score so far: " + score + " out of " + (totalQuestions - 1));
                    return;
                } else if (guess.equalsIgnoreCase("hint")) {
                    // Unit 2: substring(0, 1) gets the first letter, length() counts characters
                    String firstLetter = currentAnswer.substring(0, 1);
                    System.out.println("Hint: Starts with '" + firstLetter + "' and is "
                                     + currentAnswer.length() + " characters long.");
                } else if (isMatch(guess, currentAnswer)) {
                    System.out.println("Correct! The answer is " + currentAnswer + ".");
                    score++;
                    guessedRight = true;
                } else {
                    tries++;
                    if (tries < 3) {
                        System.out.println("Wrong! Tries left: " + (3 - tries));
                    } else {
                        System.out.println("Out of tries! The correct answer was " + currentAnswer + ".");
                    }
                }
            }
        }

        System.out.println("\n=== GAME OVER ===");
        System.out.println("You got " + score + " out of " + totalQuestions + " right!");
    }

    // Helper method using Unit 2 & 3 concepts to accept common abbreviations
    public static boolean isMatch(String guess, String answer) {
        if (guess.equalsIgnoreCase(answer)) {
            return true;
        }
        if (answer.equalsIgnoreCase("United Kingdom") &&
           (guess.equalsIgnoreCase("UK") || guess.equalsIgnoreCase("Great Britain") || guess.equalsIgnoreCase("England") || guess.equalsIgnoreCase("Scotland"))) {
            return true;
        }
        if (answer.equalsIgnoreCase("United States") &&
           (guess.equalsIgnoreCase("USA") || guess.equalsIgnoreCase("US") || guess.equalsIgnoreCase("America"))) {
            return true;
        }
        if (answer.equalsIgnoreCase("Vatican City") &&
           (guess.equalsIgnoreCase("Vatican") || guess.equalsIgnoreCase("The Vatican") || guess.equalsIgnoreCase("Holy See"))) {
            return true;
        }
        if (answer.equalsIgnoreCase("South Korea") &&
           (guess.equalsIgnoreCase("Korea") || guess.equalsIgnoreCase("Republic of Korea"))) {
            return true;
        }
        if (answer.equalsIgnoreCase("Philippines") &&
           (guess.equalsIgnoreCase("The Philippines"))) {
            return true;
        }
        return false;
    }
