    /**
     * Manages a full session of trivia questions until all questions are answered,
     * the user types 'quit', or the user fails 3 attempts on a single question.
     * 
     * @param input   The shared Scanner object for reading user guesses
     * @param prompts The master String of pipe-delimited trivia questions
     * @param answers The master String of pipe-delimited trivia answers
     * @return        true if the player won or quit voluntarily; false if the player lost
     */
    public static boolean playRound(Scanner input, String prompts, String answers) {
        int score = 0;          // Tracks how many questions the user answered correctly
        int totalQuestions = 0; // Tracks the current question number

        // Instantiate a new QuestionRandomizer object. Passing 'prompts' and 'answers' creates
        // a fresh copy inside the object so the master Strings in main() remain intact for future rounds.
        QuestionRandomizer randomizer = new QuestionRandomizer(prompts, answers);

        // Outer while loop: continues as long as at least one "|" remains in the question pool
        while (randomizer.hasQuestionsLeft()) {
            totalQuestions++;

            // Select a random question/answer pair and remove it from the pool so it cannot repeat
            randomizer.pickNextRandom();
            String currentPrompt = randomizer.getCurrentPrompt();
            String currentAnswer = randomizer.getCurrentAnswer();

            System.out.println("\nQuestion " + totalQuestions + ": " + currentPrompt);
            
            boolean guessedRight = false; // Tracks whether the user solved the current question
            int tries = 0;                // Counts failed attempts on the current question (max 3)

            // Inner while loop: uses a compound boolean expression (&&) to allow up to 3 attempts
            while (tries < 3 && !guessedRight) {
                System.out.print("Your guess (or type 'quit'): ");
                // .trim() removes accidental leading or trailing spaces typed by the user
                String guess = input.nextLine().trim();

                // Check if the user wants to exit the round early (case-insensitive)
                if (guess.equalsIgnoreCase("quit")) {
                    System.out.println("\nEnding round early...");
                    // Subtract 1 from totalQuestions because the current question was not completed
                    System.out.println("Score so far: " + score + " out of " + (totalQuestions - 1));
                    return true; // Return to main menu without triggering a Game Over
                } 
                // Validate the user's guess against the official answer and accepted aliases
                else if (isMatch(guess, currentAnswer)) {
                    System.out.println("Correct! The answer is " + currentAnswer + ".");
                    score++;             // Increment score
                    guessedRight = true; // Exit the inner guessing loop and move to the next question
                } 
                // Handle an incorrect guess
                else {
                    tries++; // Increment failed attempts
                    if (tries < 3) {
                        System.out.println("Wrong! Tries left: " + (3 - tries));
                    } else {
                        // Player used all 3 tries: display Game Over and signal main() to terminate
                        System.out.println("\nOut of tries! The correct answer was " + currentAnswer + ".");
                        System.out.println("=== YOU LOSE! GAME OVER ===");
                        System.out.println("Final Score: " + score);
                        return false; 
                    }
                }
            }
        }

        // If the outer while loop finishes naturally, the player answered every single question
        System.out.println("\n=== YOU WIN! ALL QUESTIONS CLEARED! ===");
        System.out.println("Final Score: " + score + " out of " + totalQuestions + "!");
        return true;
    }

    /**
     * Compares the player's guess to the official answer, ignoring capitalization
     * and accepting common abbreviations or alternative country names.
     * 
     * @param guess  The trimmed String entered by the user
     * @param answer The official answer String from the answer pool
     * @return       true if the guess is valid; false otherwise
     */
    public static boolean isMatch(String guess, String answer) {
        // Direct case-insensitive match (e.g., "canada" matches "Canada")
        if (guess.equalsIgnoreCase(answer)) {
            return true;
        }
        // Check common aliases using compound boolean logic (&& and ||)
        if (answer.equalsIgnoreCase("United Kingdom") &&
           (guess.equalsIgnoreCase("UK") || guess.equalsIgnoreCase("Great Britain") || guess.equalsIgnoreCase("England") || guess.equalsIgnoreCase("Scotland"))) {
            return true;
        }
        if (answer.equalsIgnoreCase("United States") &&
           (guess.equalsIgnoreCase("USA") || guess.equalsIgnoreCase("US") || guess.equalsIgnoreCase("America"))) {
            return true;
        }
        if (answer.equalsIgnoreCase("Vatican City") &&
           (guess.equalsIgnoreCase("Vatican") || guess.equalsIgnoreCase("The Vatican") || guess.equalsIgnoreCase("Holy See"))) {
            return true;
        }
        if (answer.equalsIgnoreCase("South Korea") &&
           (guess.equalsIgnoreCase("Korea") || guess.equalsIgnoreCase("Republic of Korea"))) {
            return true;
        }
        if (answer.equalsIgnoreCase("Philippines") &&
           (guess.equalsIgnoreCase("The Philippines"))) {
            return true;
        }
        // If none of the conditions matched, the guess is incorrect
        return false;
    }
