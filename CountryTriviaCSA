// RANDOMIZER CLASS (Demonstrates AP CSA Unit 2 & Unit 5 Encapsulation)
// Manages state (remaining questions) and behavior (picking without replacement).

class QuestionRandomizer {
    // Private instance variables (encapsulation) holding the shrinking pools and active pair
    private String remainingPrompts;
    private String remainingAnswers;
    private String currentPrompt;
    private String currentAnswer;

    // Constructor: initializes instance variables when 'new QuestionRandomizer(...)' is called
    public QuestionRandomizer(String prompts, String answers) {
        this.remainingPrompts = prompts;
        this.remainingAnswers = answers;
        this.currentPrompt = "";
        this.currentAnswer = "";
    }

    // Returns true if indexOf("|") finds a delimiter (returns -1 when the String is empty)
    public boolean hasQuestionsLeft() {
        return remainingPrompts.indexOf("|") != -1;
    }

    // Accessor (getter) method for the currently selected trivia question
    public String getCurrentPrompt() {
        return currentPrompt;
    }

    // Accessor (getter) method for the currently selected trivia answer
    public String getCurrentAnswer() {
        return currentAnswer;
    }

    /**
     * Helper method that traverses remainingPrompts character-by-character
     * and counts how many "|" delimiters exist, which equals the number of questions left.
     */
    private int countRemaining() {
        int count = 0;
        // Standard String traversal loop (AP CSA Unit 4)
        for (int i = 0; i < remainingPrompts.length(); i++) {
            // Extract a 1-character substring at index i and check if it equals "|"
            if (remainingPrompts.substring(i, i + 1).equals("|")) {
                count++;
            }
        }
        return count;
    }

    /**
     * Picks a random question index, extracts that question and its matching answer
     * into currentPrompt/currentAnswer, and rebuilds the remaining pools without that pair.
     */
    public void pickNextRandom() {
        int total = countRemaining();
        
        // AP CSA Unit 2 formula for generating a random integer from 0 to (total - 1):
        // Math.random() returns a double in [0.0, 1.0), multiplying scales it to [0.0, total),
        // and casting to (int) truncates the decimal portion.
        int targetIndex = (int) (Math.random() * total);

        // Temporary accumulator Strings to hold all questions/answers EXCEPT the chosen one
        String newPromptsPool = "";
        String newAnswersPool = "";

        // Iterate through every remaining question/answer pair in the pool
        for (int i = 0; i < total; i++) {
            // Find the position of the next "|" delimiter in remainingPrompts
            int pCut = remainingPrompts.indexOf("|");
            // Slice out the question text before the "|"
            String p = remainingPrompts.substring(0, pCut);
            // Shorten remainingPrompts so it starts immediately after the "|"
            remainingPrompts = remainingPrompts.substring(pCut + 1);

            // Repeat the exact same slicing process in parallel for remainingAnswers
            int aCut = remainingAnswers.indexOf("|");
            String a = remainingAnswers.substring(0, aCut);
            remainingAnswers = remainingAnswers.substring(aCut + 1);

            if (i == targetIndex) {
                // This is our randomly chosen item: save it as the active question/answer
                // and do NOT add it back into the new pools (prevents repeats)
                currentPrompt = p;
                currentAnswer = a;
            } else {
                // Not the chosen item: append it (along with its "|" delimiter) back into the pool
                newPromptsPool = newPromptsPool + p + "|";
                newAnswersPool = newAnswersPool + a + "|";
            }
        }

        // Replace the depleted pool Strings with the newly rebuilt pools
        remainingPrompts = newPromptsPool;
        remainingAnswers = newAnswersPool;
    }
}
