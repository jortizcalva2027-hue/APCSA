package stars;

/**
 *
 * @author jpnelson
 */
public class Stars {

    public static void main(String[] args)
    {
        final int MAX_ROWS = 10;


        // Pattern A: Inverted Left-Aligned Triangle

        System.out.println("a.");
        for (int row = MAX_ROWS; row >= 1; row--) {
            for (int star = 1; star <= row; star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        System.out.println();


        // Pattern B: Right-Aligned Triangle

        System.out.println("b.");
        for (int row = 1; row <= MAX_ROWS; row++) {
            // Print leading spaces (10 - row)
            for (int space = 1; space <= MAX_ROWS - row; space++) {
                System.out.print(" ");
            }
            // Print stars
            for (int star = 1; star <= row; star++) {
                System.out.print("*");
            }
            System.out.println();
        }


        // Pattern C: Inverted Right-Aligned Triangle

        System.out.println("c.");
        for (int row = MAX_ROWS; row >= 1; row--) {
            // Print leading spaces (10 - row)
            for (int space = 1; space <= MAX_ROWS - row; space++) {
                System.out.print(" ");
            }
            // Print stars
            for (int star = 1; star <= row; star++) {
                System.out.print("*");
            }
            System.out.println();
    }
        System.out.println();

     
        // Pattern D: Diamond (5 rows top half, 5 rows bottom half)
    
        System.out.println("d.");
        
        // Top Half of Diamond (Rows 1 to 5)
        for (int row = 1; row <= 5; row++) {
            // Leading spaces (5 - row)
            for (int space = 1; space <= 5 - row; space++) {
                System.out.print(" ");
            }
        
            for (int star = 1; star <= (2 * row - 1); star++) {
                System.out.print("*");
            }
            System.out.println();
        }

        // Bottom Half of Diamond (Rows 5 down to 1)
        for (int row = 5; row >= 1; row--) {
            // Leading spaces (5 - row)
            for (int space = 1; space <= 5 - row; space++) {
                System.out.print(" ");
            }
            
            for (int star = 1; star <= (2 * row - 1); star++) {
                System.out.print("*");
            }
            System.out.println();
}
}
}
