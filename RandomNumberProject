package randomnumberproject;

import java.util.Random;
import java.util.Scanner;

public class RandomNumberProject {

    public static void main(String[] args) {
        Scanner scan = new Scanner(System.in);
        Random generator = new Random();

        // PART 1: Phone Number Generator
        String p = "";
        while (!p.equals("-1")) {
            System.out.println("Press any letter to generate a phone number. Enter -1 to move to the die roller:");
            p = scan.next();

            if (!p.equals("-1")) {
                int num1 = generator.nextInt(8);
                int num2 = generator.nextInt(8);
                int num3 = generator.nextInt(8);
                int middle3 = generator.nextInt(656);
                int num7 = generator.nextInt(10);
                int num8 = generator.nextInt(10);
                int num9 = generator.nextInt(10);
                int num10 = generator.nextInt(10);

                System.out.println("Generated Phone Number: " + num1 + num2 + num3 + "-" 
                        + String.format("%03d", middle3) + "-" + num7 + num8 + num9 + num10);
            }
        }

        System.out.println("\n--- Moving to Die Roller ---\n");

        // PART 2: 6-Sided Die Roller
        String r = "";
        while (!r.equals("-1")) {
            System.out.println("Press any letter to roll the die. Enter -1 to stop:");
            r = scan.next();

            if (!r.equals("-1")) {
                int roll = generator.nextInt(6);
                System.out.println("You rolled a " + (roll + 1));
            }
        }

        System.out.println("Program finished!");
    }
}
