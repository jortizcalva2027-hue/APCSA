package snowman;

/**
 *
 * @author jortizcalva2027
 */
import java.awt.*;
import javax.swing.*;


public class Snowman extends JPanel{
  
  //this is a constructor method.
  public Snowman(){
    super();
  }
  
    /* Create a paintComponent() method to override the one in
    JPanel.This is where the drawing happens. We don't have 
    to call it in our program, it gets called automatically 
    whenever the panel needs to be redrawn, like when it is 
    made visible or moved or whatever.
  */
  public void paintComponent(Graphics g){
    final int MID = 150;
    final int TOP = 50;
    g.setColor(Color.green); //set the graphics object's paint color
    //for next action
    g.fillRect(0, 175, 300, 50); // ground
    g.setColor(Color.red); //restting paint color
    g.fillOval(0, 0, 100, 100); // sun
    g.setColor(Color.yellow); //resetting paint color
    g.fillOval(MID-40, TOP, 40, 40);// head
    g.fillOval(MID-55, TOP+35, 70, 50); // upper torso
    g.fillOval(MID-70, TOP+80, 100, 60); // lower torso
    g.setColor(Color.blue);
    g.fillOval(MID-30, TOP+10, 5, 5); // left eye
    g.fillOval(MID-15, TOP+10, 5, 5);// right eye
    g.drawArc(MID-30, TOP+20, 20, 10, 190, 160); // smile
    g.drawLine(MID-25, TOP+40, MID-100, TOP+50); // left arm
    g.drawLine(MID+5, TOP+60, MID+75, TOP+60); // right arm
    g.drawLine(MID-40, TOP+5, MID+20, TOP+5); // brim of hat
    g.fillRect(MID-45, TOP-20, 60, 25);// top of hat
    g.setColor(Color.black);
    g.fillPolygon(new int[] {200, 245, 300}, new int[] {200, 20, 200}, 3);
  }

    /**
     * @param args the command line arguments
     */
    public static void main(String arg[]){
        //create a new JFrame object, initialize
        JFrame frame = new JFrame("Display Graphics");
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        frame.setSize(400,300);

        // Create a new identifier for a Basic JPanel (DisplayGraphics) called "panel",
        // then create a new BasicJPanel object for it to refer to.
        Snowman panel = new Snowman();

        // Make the panel object the content pane of the JFrame.
        // This puts it into the drawable area of frame, and now
        // we do all our drawing to panel, using paintComponent(), above.
        frame.setContentPane(panel);
        frame.setVisible(true);
    }
    
}
