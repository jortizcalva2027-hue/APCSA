package mystore;

import java.util.Scanner;

public class MyStore {
    public static void main(String[] args) {
final double MAX_BUDGET = 250.00;
        double dblTotalSpent = 0.0;
        int intItemCount = 0;

        Scanner scanner = new Scanner(System.in);

        while (true) {
            System.out.print("Enter item name (or 'quit' to stop): ");
            String input = scanner.nextLine();

            if (input.equalsIgnoreCase("quit")) {
                break;
            }

            // Create item object based on input
            Item item = null;
            if (input.equalsIgnoreCase("T Shirt")) {
                item = new Item("T Shirt", 29.99);
            } else if (input.equalsIgnoreCase("Shoes")) {
                item = new Item("Shoes", 125.99);
            } else if (input.equalsIgnoreCase("Jeans")) {
                item = new Item("Jeans", 60.99);
            } else if (input.equalsIgnoreCase("Jacket")) {
                item = new Item("Jacket", 250.00);
            } else if (input.equalsIgnoreCase("Hat")) {
                item = new Item("Hat", 25.99);
            } else if (input.equalsIgnoreCase("Shorts")) {
                item = new Item("Shorts", 75.99);
            } else if (input.equalsIgnoreCase("Blouse")) {
                item = new Item("Blouse", 88.99);
            } else {
                System.out.println("Invalid item!");
                continue;
            }

            // Check budget constraint
            if (dblTotalSpent + item.getDblPrice() > MAX_BUDGET) {
                System.out.println("WARNING: Over budget! Cannot buy " + item.getStrName());
            } else {
                dblTotalSpent += item.getDblPrice();
                intItemCount++;
                
                System.out.println(item.toString());
                System.out.println("Items bought: " + intItemCount);
                System.out.println("Total spent so far: $" + dblTotalSpent);
            }
            System.out.println();
        }

        System.out.println("Final total items: " + intItemCount);
        System.out.println("Final total spent: $" + dblTotalSpent);
    }
}

class Item {
    private String strName;
    private double dblPrice;

    public Item(String name, double price) {
        strName = name;
        dblPrice = price;
    }

    public String getStrName() {
        return strName;
    }

    public void setStrName(String name) {
        strName = name;
    }

    public double getDblPrice() {
        return dblPrice;
    }

    public void setDblPrice(double price) {
        dblPrice = price;
    }

    public String toString() {
        return "Item: " + strName + ", Price: " + dblPrice;
    }
}
